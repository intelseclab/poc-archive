# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.pyc
*.pyo
.env
venv/
.venv/

# Node
node_modules/

# Compiled binaries / build artifacts
*.o
*.so
*.elf
*.bin
*.out

# Sensitive — never commit these
*.key
*.pem
*.p12
*.pfx
credentials.txt
secrets.txt
loot/
captured/

# Hugo — generated content (rebuilt from pocs/ by scripts/build-hugo-content.py)
content/pocs/
.hugo_build.lock

# Local-only reference reports (not part of the site)
reports/

# CVE monitor Cloudflare Worker — deployed directly, deliberately not published in this repo
worker/

# Local secrets — only .env.example is tracked
.env.*
!.env.example

# Owner-only admin tooling — operational scripts for the maintainer, not the
# community. review.py needs the monitor API key; check-patch-status.py is a
# one-off audit harness. Neither is part of the site build.
scripts/review.py
scripts/check-patch-status.py

    <item>
      <title>rldns 1.3 Heap-Based Out-of-Bounds Read Remote DoS (CVE-2026-27831)</title>
      <link>http://192.168.0.124:1313/pocs/binary/2026-07-05_cve-2026-27831-rldns-heap-oob-read-dos/</link>

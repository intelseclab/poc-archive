    <item>
      <title>Chrome CSSFontFeatureValuesMap Use-After-Free (CVE-2026-2441)</title>
      <link>http://100.89.152.30:1313/pocs/web/2026-05-16_chrome-cssfontfeaturevaluesmap-use-after-free/</link>
      <pubDate>Sat, 16 May 2026 00:00:00 +0000</pubDate>

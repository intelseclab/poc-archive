    <item>
      <title>Budibase Authentication Bypass to Plugin-Upload Reverse Shell — CVE-2026-31816</title>
      <link>http://192.168.0.124:1313/pocs/web/2026-07-05_cve-2026-31816-budibase-auth-bypass-rce/</link>
      <pubDate>Sun, 05 Jul 2026 00:00:00 +0000</pubDate>

    <item>
      <title>BookingPress Pro Unauthenticated Arbitrary File Upload via Data URI Signature Field (CVE-2026-6960)</title>
      <link>http://192.168.0.124:1313/pocs/web/2026-07-05_cve-2026-6960-bookingpress-unauth-file-upload/</link>
      <pubDate>Sun, 05 Jul 2026 00:00:00 +0000</pubDate>

      <title>Spectra Gutenberg Blocks Authenticated Remote Code Execution — CVE-2026-7465</title>
      <link>http://192.168.0.124:1313/pocs/web/2026-07-05_cve-2026-7465-poc/</link>
      <pubDate>Sun, 05 Jul 2026 00:00:00 +0000</pubDate>

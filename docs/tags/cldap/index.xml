    <item>
      <title>Netlogon CLDAP Stack Buffer Overflow (CVE-2026-41089)</title>
      <link>http://localhost:1315/pocs/network/2026-06-04_netlogon-cldap-stack-buffer-overflow/</link>
      <pubDate>Thu, 04 Jun 2026 00:00:00 +0000</pubDate>

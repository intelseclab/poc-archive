    <item>
      <title>Next.js CSP Nonce Cache-Poisoned XSS (CVE-2026-44581)</title>
      <link>http://localhost:1313/poc-archive/pocs/web/2026-05-17_nextjs-csp-nonce-cache-poisoned-xss/</link>
      <pubDate>Sun, 17 May 2026 00:00:00 +0000</pubDate>

    <item>
      <title>Next.js Cache Components Connection Exhaustion DoS (CVE-2026-44579)</title>
      <link>http://192.168.0.124:1313/pocs/web/2026-05-17_nextjs-cache-components-connection-exhaustion-dos/</link>
      <pubDate>Sun, 17 May 2026 00:00:00 +0000</pubDate>

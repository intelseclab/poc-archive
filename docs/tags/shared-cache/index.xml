    <item>
      <title>Next.js RSC Response Cache Poisoning (CVE-2026-44576)</title>
      <link>http://localhost:1313/poc-archive/pocs/web/2026-05-17_nextjs-rsc-response-cache-poisoning/</link>
      <pubDate>Sun, 17 May 2026 00:00:00 +0000</pubDate>

    <item>
      <title>Krayin CRM — TinyMCE Upload Unrestricted File Upload to RCE (CVE-2026-38526)</title>
      <link>http://192.168.0.124:1313/pocs/web/2026-07-05_cve-2026-38526-krayin-crm-file-upload-rce/</link>

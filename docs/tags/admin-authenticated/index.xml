      <title>Visitor Management System 1.0 — Unrestricted File Upload to RCE (CVE-2026-37748)</title>
      <link>http://192.168.0.124:1313/pocs/web/2026-07-05_cve-2026-37748-visitor-management-system-file-upload-rce/</link>
      <pubDate>Sun, 05 Jul 2026 00:00:00 +0000</pubDate>

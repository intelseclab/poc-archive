      <title>LiteSpeed User-End cPanel Plugin Local Privilege Escalation (CVE-2026-48172)</title>
      <link>http://localhost:1313/poc-archive/pocs/web/2026-05-30_litespeed-user-end-cpanel-plugin-privesc/</link>
      <pubDate>Sat, 30 May 2026 00:00:00 +0000</pubDate>

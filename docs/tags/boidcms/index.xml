    <item>
      <title>BoidCMS — Authenticated File Upload to RCE via Template Injection (CVE-2026-39387)</title>
      <link>http://192.168.0.124:1313/pocs/web/2026-07-05_cve-2026-39387-boidcms-file-upload-rce/</link>
      <pubDate>Sun, 05 Jul 2026 00:00:00 +0000</pubDate>

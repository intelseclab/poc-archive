    <item>
      <title>Citrix NetScaler CitrixBleed 2 Session Token Disclosure (CVE-2025-5777)</title>
      <link>http://100.89.152.30:1313/pocs/web/2026-05-16_citrixbleed-2-session-token-disclosure/</link>
      <pubDate>Sat, 16 May 2026 00:00:00 +0000</pubDate>

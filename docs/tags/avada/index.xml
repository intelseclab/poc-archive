      <title>Avada Builder Unauthenticated RCE via call_user_func() Allowlist Bypass (CVE-2026-6279)</title>
      <link>http://192.168.0.124:1313/pocs/web/2026-07-05_cve-2026-6279-avada-builder-rce/</link>
      <pubDate>Sun, 05 Jul 2026 00:00:00 +0000</pubDate>
